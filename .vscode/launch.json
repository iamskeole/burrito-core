{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "preLaunchTask": "setup-dev-environment",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: pytest – all tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "-s", // show print output
                "--maxfail=1", // stop after first failure
                "-vv", // very verbose
                "." // run the whole repo
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": true // allow stepping into your own code
        }
    ]
}
{
  "$schema": "https://grafana.com/schemas/dashboard/1.json",
  "title": "Burrito LLM Proxy Metrics",
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests per Minute",
      "targets": [
        {
          "expr": "sum(rate(burrito_requests_total[1m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Request Latency (95th percentile)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(burrito_request_latency_seconds_success[1m])) by (le))"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(burrito_request_latency_seconds_error[1m])) by (le))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Generation Duration (95th percentile)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(burrito_generation_duration_seconds[1m])) by (le,wire_api,model))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Tokens per Model (Last 5m)",
      "targets": [
        {
          "expr": "sum(rate(burrito_generation_input_tokens[5m])) by (wire_api,model)"
        },
        {
          "expr": "sum(rate(burrito_generation_output_tokens[5m])) by (wire_api,model)"
        },
        {
          "expr": "sum(rate(burrito_generation_reasoning_tokens[5m])) by (wire_api,model)"
        },
        {
          "expr": "sum(rate(burrito_generation_tool_call_tokens[5m])) by (wire_api,model)"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Tool Call Counts",
      "targets": [
        {
          "expr": "sum(rate(burrito_generation_tool_calls_total[5m])) by (wire_api,model,tool_name)"
        }
      ]
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s"
}


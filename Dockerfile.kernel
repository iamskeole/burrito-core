# pinned: equals jupyter/minimal-notebook:latest (tag frozen since 2023-10;
# python 3.11.6 / ipykernel 6.25.2) so rebuilds stay reproducible
FROM jupyter/minimal-notebook@sha256:1c4c8b6c7c27059c353d4e80523c2696e34723fde67d27418873ebeb42032551

USER root
RUN pip install --no-cache-dir sympy numpy pandas

# burrito rewrites `pip install` / `uv pip install` lines in agent code to
# `!uv pip install`, so the kernel needs the uv binary too
# (pinned: the version the kernel image has been tested with)
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

# The kernel process writes its own connection file here at boot
# (burrito reads it back through the Docker API)
RUN mkdir -p /tmp/jupyter-runtime && chown -R 1000:100 /tmp/jupyter-runtime

# The base image's healthcheck probes a jupyter server, which this
# container never runs; silence the misleading "unhealthy" status
HEALTHCHECK NONE

USER $NB_UID

# The kernel reads (or, if missing, generates) the connection file for
# $KERNEL_ID and binds its ZMQ ports to 0.0.0.0 so the burrito app can
# reach it over the compose network
CMD ["sh", "-c", "python -m ipykernel_launcher -f /tmp/jupyter-runtime/${KERNEL_ID}.json --ip=0.0.0.0"]

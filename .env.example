# burrito configuration
# Copy this file to `.env` and adjust; docker-compose reads it for ${...}
# interpolation, and the burrito container inherits any variable you set.

# Required: your gpt-oss inference backend (llama.cpp or vLLM), as seen
# from the burrito container. Do NOT include a trailing /v1.
BACKEND_BASE_URL=http://apollo.local:9999

# browser.search backend.
# By default burrito uses the bundled SearXNG instance (see
# docker-compose.yml). Set a Brave API key to prefer Brave instead.
# BRAVE_API_KEY=

# Python tool backend:
#   jupyter-in-process   (default) - kernels run inside the burrito container
#   jupyter-docker-kernels         - kernels run in isolated burrito-kernel
#                                    containers (build that image first:
#                                    docker compose build burrito-kernel)
# PYTHON_BACKEND=jupyter-docker-kernels

# Optional: protect the /metrics endpoint
# METRICS_AUTH_TOKEN=

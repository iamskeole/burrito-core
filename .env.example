# burrito configuration
#
# Copy this file to `.env` and adjust. docker-compose reads it for
# ${...} interpolation only: the file itself is NOT baked into the
# image (.dockerignore), so a variable reaches the burrito container
# only when docker-compose.yml passes it through. Every variable
# below is wired up there; leave it unset and the shown default
# applies. (In local dev, docker-compose.test.yml mounts the repo
# into the container, so the app also reads `.env` directly.)

# --- Inference backend ---------------------------------------------------

# Required: your gpt-oss inference backend (llama.cpp or vLLM), as
# seen from the burrito container. Do NOT include a trailing /v1.
BACKEND_BASE_URL=http://apollo.local:9999

# Model id sent to the backend. Change it if your backend serves the
# model under a different name.
# DEFAULT_MODEL_NAME=openai/gpt-oss-20b

# Seconds to wait for the next token from the backend before the
# request is aborted. Raise this for slow (local) backends.
# BACKEND_INTER_TOKEN_TIMEOUT=120

# --- Search backend (browser.search) --------------------------------------

# By default burrito uses the bundled SearXNG instance (see
# docker-compose.yml). Set a Brave API key to prefer Brave instead,
# or point SEARXNG_API_URL at your own SearXNG.
# BRAVE_API_KEY=
# SEARXNG_API_URL=http://searxng:8080

# --- Python tool ------------------------------------------------------------

# Execution backend:
#   jupyter-in-process     (default) kernels run inside the burrito container
#   jupyter-docker-kernels           kernels run in isolated burrito-kernel
#                                    containers (build that image first:
#                                    docker compose build burrito-kernel)
# PYTHON_BACKEND=jupyter-docker-kernels

# Set to False to hide the tool from the model entirely.
# IS_PYTHON_TOOL_AVAILABLE=True

# Default (False): the tool is only enabled when the request's tools
# list explicitly asks for it. True: always send it to the model.
# IS_PYTHON_TOOL_ALWAYS_ENABLED=True

# --- Browser tool (web fetch + search) --------------------------------------

# Set to False to hide the tool from the model entirely.
# IS_BROWSER_TOOL_AVAILABLE=True

# Default (False): the tool is only enabled when the request's tools
# list asks for it (a browser tool, or a WebFetch / WebSearch tool).
# True: always send it to the model.
# IS_BROWSER_TOOL_ALWAYS_ENABLED=True

# Locale, language and timezone used for searches and echoed into the
# model's prompt (e.g. de-DE / de / Europe/Berlin).
# BROWSER_LOCALE=en-GB
# BROWSER_LANGUAGE=en
# BROWSER_TIMEZONE=Europe/London

# --- Model behaviour (Harmony) ----------------------------------------------

# Personality baked into the system message: default | v1 | caveman
# (see src/burrito/prompts/model_identity_*.md).
# MODEL_IDENTITY=default

# Date injected into the system message: auto (server timezone),
# auto-utc, off, or a fixed YYYY-MM-DD (pin it for reproducible evals).
# SYSTEM_MESSAGE_DATE_CONFIG=auto-utc

# Drop old assistant reasoning messages from context to save tokens.
# PRUNE_REASONING=True

# --- Ops ----------------------------------------------------------------------

# debug | info | warning | error. The container defaults to info; set
# to debug for the verbose in-app default.
# LOG_LEVEL=info

# Protect the /metrics endpoint with a bearer token and/or a
# comma-separated IP whitelist. Both empty = endpoint is open.
# METRICS_AUTH_TOKEN=
# METRICS_IP_WHITELIST=

# --- docker-compose only (bundled SearXNG service) ---------------------------

# These feed only the searxng service, not the burrito container.
# The SEARXNG_SECRET fallback (abc-123) is a weak placeholder - set
# your own when you expose the service.
# SEARXNG_SECRET=
# UWSGI_WORKERS=4
# UWSGI_THREADS=1
